# Linear, quadratic and cubic equations, systems and edge cases.
solve(2*x+3 = 7, x)
solve(x^2-5*x+6 = 0, x)
solve(x^2 = 4)
solve(x^2+1 = 0, x)
solve(x^3-1 = 0, x)
solve(a*x^2+b*x+c, x)
solve(x^5-x-1)
solve((x^2-1)/(x-1))
r = solve(x^3-2, x, 1);
r + 1
solve([x+y = 3, x-y = 1], [x, y])
solve([x+y+z = 6, x-y = 0, y-z = 0], [x, y, z])
solve([x^2+y^2 = 25, x-y = 1])
solve([x+y = 1, 2x+2y = 2], [x, y])
solve([x+y = 1, x+y = 2], [x, y])
solve([x*y = 1, x+y = 2])
