# One-sided limits, limits at infinity, L'Hopital and Taylor series.
limit(sin(x)/x, x = 0)
limit((exp(x)-1)/x, x = 0)
limit((x^2-1)/(x-1), x = 1)
limit(1/x, x = 0, right)
limit(1/x, x = 0, left)
limit(x*ln(x), x = 0, right)
limit(ln(x)/x, x = inf)
limit((1+1/x)^x, x = inf)
limit(sqrt(x^2+x)-x, x = inf)
limit(x^2/(x-1), x = inf)
taylor(ln(x), x = 1, 3)
taylor(sin(x), x = 0, 5)
